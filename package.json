{
  "name": "tripsplit-planner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TripSplit Planner - Collaborative shared trip planning, conflict detection, and expense splitting (MERN Stack)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c blue,teal \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "lint": "eslint .",
    "test": "npm test --workspace=server && npm test --workspace=client",
    "test:server": "npm test --workspace=server",
    "test:client": "npm test --workspace=client",
    "test:e2e": "npm run build && playwright test",
    "seed:demo": "npm run seed:demo --workspace=server"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.50.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.14.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
