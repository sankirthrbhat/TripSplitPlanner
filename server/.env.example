# Server configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection URI (MongoDB Atlas or local mongod)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/tripsplit?retryWrites=true&w=majority
# Leave empty in local development to use persistent embedded MongoDB (.data/mongodb)
MONGODB_URI=

# JWT Authentication Secret (Required - minimum 32 characters in production)
JWT_SECRET=replace-with-a-long-random-secret-key-at-least-32-chars
JWT_EXPIRES_IN=7d

# Allowed client origin(s) for CORS & CSRF Origin checks (comma-separated)
CLIENT_ORIGIN=http://localhost:5173

# Optional: Set to true only if deploying behind a reverse proxy (e.g. Render)
TRUST_PROXY=false

# Set to true only in local dev if you want mongodb-memory-server fallback when MONGODB_URI is blank
ALLOW_EMBEDDED_MONGO=true

